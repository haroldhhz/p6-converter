# Environment variables for p6-converter backend
# Copy this file to .env and fill in your values

# ─── Azure Document Intelligence ───────────────────────────────────────────
# Endpoint format: https://<resource-name>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR_RESOURCE_NAME.cognitiveservices.azure.com/
# Use either KEY or DefaultAzureCredential (MSI)
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ─── Azure OpenAI ────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ─── App Settings ────────────────────────────────────────────────────────────
# Date used in WBS IDs when not provided by the user
DEFAULT_DATA_DATE=2026-02-28

# Comma-separated list of allowed CORS origins (no trailing slash)
ALLOWED_ORIGINS=https://YOUR_FRONTEND.azurewebsites.net,https://YOUR_FRONTEND.stas.windows.net

# ─── Authentication ───────────────────────────────────────────────────────────
# Comma-separated list of allowed email addresses for Azure AD authentication
# Only users with these emails will be able to access the app after signing in
ALLOWED_EMAILS=haroldhuang@microsoft.com,jonathan.heng@linesight.com,emmberger@microsoft.com,kpawaskar@microsoft.com,gdubois@microsoft.com

# ─── Microsoft Entra ID SSO ─────────────────────────────────────────────────
# Register the app at: portal.azure.com → Microsoft Entra ID → App registrations
# Then assign app roles via Enterprise Applications → LAP Platform → Users and groups
ENTRA_TENANT_ID=               # Directory (tenant) ID — app registration → Overview
ENTRA_CLIENT_ID=               # Application (client) ID — app registration → Overview
ADMIN_ROLE_NAME=Admin          # Must match the "Value" field of the Admin app role you created
